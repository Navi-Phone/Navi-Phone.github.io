        <div class="footer-msg">
           מעוניין להיות טכנאי מורשה? צור קשר: 053-945-5166
        </div>
    </div>

    <script>
        window.processData = function(json) {
            try {
                const table = json.table;
                let rows = table.rows; 

                const headRow = document.getElementById('headRow');
                const bodyRows = document.getElementById('bodyRows');

                if (rows.length > 0) {
                    const firstRow = rows.shift(); 
                    if (firstRow.c) {
                        firstRow.c.forEach(cell => {
                            const th = document.createElement('th');
                            th.textContent = (cell && cell.v !== null) ? cell.v : '';
                            headRow.appendChild(th);
                        });
                    }
                }

                rows.forEach(row => {
                    const tr = document.createElement('tr');
                    const cells = row.c; 
                    if (cells) {
                        cells.forEach(cell => {
                            const td = document.createElement('td');
                            const val = (cell && cell.f) ? cell.f : (cell && cell.v !== null ? cell.v : '');
                            td.textContent = val;
                            tr.appendChild(td);
                        });
                        bodyRows.appendChild(tr);
                    }
                });

                document.getElementById('status').style.display = 'none';
                document.getElementById('tableDiv').style.display = 'block';

            } catch (error) {
                console.error(error);
                document.getElementById('status').innerText = 'שגיאה בפענוח הנתונים';
                document.getElementById('status').style.color = 'red';
            }
        };
    </script>

